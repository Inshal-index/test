rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update: if scheduleId == 'current';
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if announcementId == 'current';
    }
  }
}
