rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public writes are required for the browser-only teacher login; those roles are not verifiable here.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update: if scheduleId == 'current';
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if announcementId == 'current';
    }
  }
}
